/**
 * Google Apps Script for BCP Bank Transaction Monitoring
 * This script monitors emails from BCP bank and extracts transaction data
 * to send to Azure Function for processing
 */

// Configuration
const CONFIG = {
  EMAIL_SENDER: 'notificaciones@notificacionesbcp.com.pe',
  AZURE_FUNCTION_URL: 'https://your-function-app.azurewebsites.net/api/movements/ingest', // Update with your actual endpoint
  PROCESS_LABEL: 'BCP/Processed',
  ERROR_LABEL: 'BCP/Error',
  MAX_EMAILS_PER_RUN: 50
};

// Movement types matching your TypeScript enum
const MovementType = {
  EXPENSE: 'EXPENSE',
  INCOME: 'INCOME',
  TRANSFER: 'TRANSFER'
};

/**
 * Main function to check for new emails
 * Can be triggered by:
 * - Time-driven trigger (every 5 minutes)
 * - Manual execution
 */
function checkEmailTrigger() {
  try {
    const threads = GmailApp.search(`from:${CONFIG.EMAIL_SENDER} is:unread`, 0, CONFIG.MAX_EMAILS_PER_RUN);
    
    Logger.log(`Found ${threads.length} unread email(s) from BCP`);
    
    threads.forEach(thread => {
      try {
        const message = thread.getMessages()[0];
        const subject = message.getSubject();
        const plainBody = message.getPlainBody();
        const htmlBody = message.getBody();
        
        Logger.log(`Processing email: ${subject}`);
        
        // Parse the transaction from email body
        const transaction = parseTransaction(subject, plainBody, htmlBody, message.getDate());
        
        if (transaction) {
          // Send to Azure Function
          const success = sendToAzureFunction(transaction);
          
          if (success) {
            thread.markRead();
            applyLabel(thread, CONFIG.PROCESS_LABEL);
            Logger.log(`Successfully processed: ${subject}`);
          } else {
            applyLabel(thread, CONFIG.ERROR_LABEL);
            Logger.log(`Failed to send to Azure Function: ${subject}`);
          }
        } else {
          Logger.log(`Could not parse transaction from: ${subject}`);
          applyLabel(thread, CONFIG.ERROR_LABEL);
        }
        
      } catch (error) {
        Logger.log(`Error processing individual email: ${error.message}`);
        applyLabel(thread, CONFIG.ERROR_LABEL);
      }
    });
    
  } catch (error) {
    Logger.log(`Error in checkEmailTrigger: ${error.message}`);
  }
}

/**
 * Parse transaction from email content
 */
function parseTransaction(subject, plainBody, htmlBody, emailDate) {
  // Try different parsers based on transaction type
  const parsers = [
    parseRetiro,           // Withdrawal from ATM/agent
    parseConsumo,          // Credit/debit card consumption
    parseYapeo,            // Mobile payment (Yape)
    parseTransferencia,    // Transfer
    parseGenericMovement   // Fallback parser
  ];
  
  for (const parser of parsers) {
    try {
      const transaction = parser(subject, plainBody, emailDate);
      if (transaction) {
        return transaction;
      }
    } catch (error) {
      Logger.log(`Parser error: ${error.message}`);
    }
  }
  
  return null;
}

/**
 * Parse "Retiro" (Withdrawal) transactions
 * Example: "Realizaste un retiro de S/ 450.00 con tu Tarjeta de Débito BCP"
 */
function parseRetiro(subject, body, emailDate) {
  if (!body.includes('retiro') && !subject.toLowerCase().includes('retiro')) {
    return null;
  }
  
  const movement = createBaseMovement();
  movement.type = MovementType.EXPENSE;
  
  // Extract name
  const nameMatch = body.match(/Hola\s+([^,]+),/);
  if (nameMatch) {
    movement.payee = nameMatch[1].trim();
  }
  
  // Extract amount and currency
  const amountMatch = body.match(/retiro de\s+(S\/|USD)\s*([\d,]+\.\d{2})/i);
  if (amountMatch) {
    movement.currency = amountMatch[1] === 'S/' ? 'PEN' : 'USD';
    movement.amount = -Math.abs(parseFloat(amountMatch[2].replace(',', '')));
  }
  
  // Extract card type and operation
  const cardMatch = body.match(/Tarjeta de (Débito|Crédito) BCP/i);
  if (cardMatch) {
    movement.bankDescription = `Retiro - Tarjeta de ${cardMatch[1]}`;
  }
  
  // Extract date
  const dateMatch = body.match(/(\d{2}) de (\w+) de (\d{4}) - (\d{2}):(\d{2}) (AM|PM)/);
  if (dateMatch) {
    movement.date = parseSpanishDate(dateMatch[0]);
  } else {
    movement.date = emailDate.toISOString();
  }
  
  // Extract card number (last 4 digits)
  const cardNumMatch = body.match(/\*{4}\s*(\d{4})/);
  if (cardNumMatch) {
    movement.accountOrCardId = `CARD_${cardNumMatch[1]}`;
  }
  
  // Extract operation number
  const opNumMatch = body.match(/Número de operación\s+(\d+)/);
  if (opNumMatch) {
    movement.operationNumber = opNumMatch[1];
  }
  
  // Extract channel/location
  const canalMatch = body.match(/Canal\s+([^\n]+)/);
  if (canalMatch) {
    movement.additionalInfo = `Canal: ${canalMatch[1].trim()}`;
  }
  
  return movement;
}

/**
 * Parse "Consumo" (Card consumption) transactions
 * Example: "Realizaste un consumo de S/ 60.00 con tu Tarjeta de Crédito BCP en QEMA MANCORA BAR"
 */
function parseConsumo(subject, body, emailDate) {
  if (!body.includes('consumo') && !subject.toLowerCase().includes('consumo')) {
    return null;
  }
  
  const movement = createBaseMovement();
  movement.type = MovementType.EXPENSE;
  
  // Extract name
  const nameMatch = body.match(/Hola\s+([^,]+),/);
  if (nameMatch) {
    movement.additionalInfo = `Usuario: ${nameMatch[1].trim()}`;
  }
  
  // Extract amount and currency
  const amountMatch = body.match(/consumo de\s+(S\/|USD)\s*([\d,]+\.\d{2})/i);
  if (amountMatch) {
    movement.currency = amountMatch[1] === 'S/' ? 'PEN' : 'USD';
    movement.amount = -Math.abs(parseFloat(amountMatch[2].replace(',', '')));
  }
  
  // Extract merchant/company name
  const empresaMatch = body.match(/Empresa\s+([^\n]+)/);
  if (empresaMatch) {
    movement.payee = empresaMatch[1].trim();
  } else {
    // Try to extract from subject
    const merchantMatch = body.match(/en\s+([^\.]+)\./);
    if (merchantMatch) {
      movement.payee = merchantMatch[1].trim();
    }
  }
  
  // Extract card type
  const cardMatch = body.match(/Tarjeta de (Débito|Crédito) BCP/i);
  if (cardMatch) {
    movement.bankDescription = `Consumo - Tarjeta de ${cardMatch[1]}`;
  }
  
  // Extract date
  const dateMatch = body.match(/(\d{2}) de (\w+) de (\d{4}) - (\d{2}):(\d{2}) (AM|PM)/);
  if (dateMatch) {
    movement.date = parseSpanishDate(dateMatch[0]);
  } else {
    movement.date = emailDate.toISOString();
  }
  
  // Extract card number
  const cardNumMatch = body.match(/\*{10,}(\d{4})/);
  if (cardNumMatch) {
    movement.accountOrCardId = `CARD_${cardNumMatch[1]}`;
  }
  
  // Extract operation number
  const opNumMatch = body.match(/Número de operación\s+(\d+)/);
  if (opNumMatch) {
    movement.operationNumber = opNumMatch[1];
  }
  
  return movement;
}

/**
 * Parse "Yapeo" (Mobile payment) transactions
 * Example: "Realizaste un yapeo a celular de S/ 250.00 desde tu Clasica Soles"
 */
function parseYapeo(subject, body, emailDate) {
  if (!body.toLowerCase().includes('yapeo') && !subject.toLowerCase().includes('yapeo')) {
    return null;
  }
  
  const movement = createBaseMovement();
  movement.type = MovementType.TRANSFER; // Yape is essentially a transfer
  
  // Extract name
  const nameMatch = body.match(/Hola\s+([^,]+),/);
  if (nameMatch) {
    movement.additionalInfo = `Usuario: ${nameMatch[1].trim()}`;
  }
  
  // Extract amount and currency
  const amountMatch = body.match(/yapeo.*de\s+(S\/|USD)\s*([\d,]+\.\d{2})/i);
  if (amountMatch) {
    movement.currency = amountMatch[1] === 'S/' ? 'PEN' : 'USD';
    movement.amount = -Math.abs(parseFloat(amountMatch[2].replace(',', '')));
  }
  
  // Extract recipient
  const recipientMatch = body.match(/Enviado a\s+([^\n]+)/);
  if (recipientMatch) {
    const recipientInfo = recipientMatch[1].trim();
    movement.payee = recipientInfo.split('\n')[0].trim();
  }
  
  // Extract destination
  const destinoMatch = body.match(/Destino\s+([^\n]+)/);
  if (destinoMatch) {
    movement.targetAccountOrCardId = destinoMatch[1].trim();
  }
  
  // Extract source account
  const desdeMatch = body.match(/Desde\s+([^\n]+)/);
  if (desdeMatch) {
    const accountInfo = desdeMatch[1].trim();
    const accountNumMatch = accountInfo.match(/\*{4}\s*(\d{4})/);
    if (accountNumMatch) {
      movement.accountOrCardId = `ACCOUNT_${accountNumMatch[1]}`;
    }
  }
  
  // Extract currency type
  const monedaMatch = body.match(/Moneda\s+(Soles|Dólares)/i);
  if (monedaMatch) {
    movement.currency = monedaMatch[1].toLowerCase() === 'soles' ? 'PEN' : 'USD';
  }
  
  movement.bankDescription = 'Yapeo a celular';
  
  // Extract date
  const dateMatch = body.match(/(\d{2}) de (\w+) de (\d{4}) - (\d{2}):(\d{2}) (AM|PM)/);
  if (dateMatch) {
    movement.date = parseSpanishDate(dateMatch[0]);
  } else {
    movement.date = emailDate.toISOString();
  }
  
  // Extract operation number
  const opNumMatch = body.match(/Número de operación\s+(\d+)/);
  if (opNumMatch) {
    movement.operationNumber = opNumMatch[1];
  }
  
  // Extract channel
  const canalMatch = body.match(/Canal\s+([^\n]+)/);
  if (canalMatch) {
    movement.notes = `Canal: ${canalMatch[1].trim()}`;
  }
  
  return movement;
}

/**
 * Parse "Transferencia" (Transfer) transactions
 * Example: "Realizaste una transferencia de S/ 1.01 desde tu Clasica"
 */
function parseTransferencia(subject, body, emailDate) {
  if (!body.toLowerCase().includes('transferencia') && !subject.toLowerCase().includes('transferencia')) {
    return null;
  }
  
  const movement = createBaseMovement();
  movement.type = MovementType.TRANSFER;
  
  // Extract name
  const nameMatch = body.match(/Hola\s+([^,]+),/);
  if (nameMatch) {
    movement.additionalInfo = `Usuario: ${nameMatch[1].trim()}`;
  }
  
  // Extract amount and currency
  const amountMatch = body.match(/transferencia de\s+(S\/|USD)\s*([\d,]+\.\d{2})/i);
  if (amountMatch) {
    movement.currency = amountMatch[1] === 'S/' ? 'PEN' : 'USD';
    movement.amount = -Math.abs(parseFloat(amountMatch[2].replace(',', '')));
  }
  
  // Extract recipient
  const recipientMatch = body.match(/Enviado a\s+([^\n]+)/);
  if (recipientMatch) {
    const lines = recipientMatch[1].split('\n');
    movement.payee = lines[0].trim();
    
    // Try to get account number from second line
    if (lines.length > 1) {
      const accountMatch = lines[1].match(/\*{4}\s*(\d{4})/);
      if (accountMatch) {
        movement.targetAccountOrCardId = `ACCOUNT_${accountMatch[1]}`;
      }
    }
  }
  
  // Extract source account
  const desdeMatch = body.match(/Desde\s+([^\n]+)/);
  if (desdeMatch) {
    const accountInfo = desdeMatch[1].trim();
    const accountNumMatch = accountInfo.match(/\*{4}\s*(\d{4})/);
    if (accountNumMatch) {
      movement.accountOrCardId = `ACCOUNT_${accountNumMatch[1]}`;
    }
  }
  
  // Extract currency
  const monedaMatch = body.match(/Moneda\s+(Soles|Dólares)/i);
  if (monedaMatch) {
    movement.currency = monedaMatch[1].toLowerCase() === 'soles' ? 'PEN' : 'USD';
  }
  
  // Extract operation type
  const operationMatch = body.match(/Operación realizada\s+([^\n]+)/);
  if (operationMatch) {
    movement.bankDescription = operationMatch[1].trim();
  } else {
    movement.bankDescription = 'Transferencia a terceros BCP';
  }
  
  // Extract date
  const dateMatch = body.match(/(\d{2}) de (\w+) de (\d{4}) - (\d{2}):(\d{2}) (AM|PM)/);
  if (dateMatch) {
    movement.date = parseSpanishDate(dateMatch[0]);
  } else {
    movement.date = emailDate.toISOString();
  }
  
  // Extract operation number
  const opNumMatch = body.match(/Número de operación\s+(\d+)/);
  if (opNumMatch) {
    movement.operationNumber = opNumMatch[1];
  }
  
  // Extract channel
  const canalMatch = body.match(/Canal\s+([^\n]+)/);
  if (canalMatch) {
    movement.notes = `Canal: ${canalMatch[1].trim()}`;
  }
  
  return movement;
}

/**
 * Generic parser for other movement types
 */
function parseGenericMovement(subject, body, emailDate) {
  const movement = createBaseMovement();
  
  // Try to extract basic information
  const amountMatch = body.match(/(S\/|USD)\s*([\d,]+\.\d{2})/i);
  if (amountMatch) {
    movement.currency = amountMatch[1] === 'S/' ? 'PEN' : 'USD';
    movement.amount = parseFloat(amountMatch[2].replace(',', ''));
  }
  
  movement.bankDescription = subject;
  movement.date = emailDate.toISOString();
  
  const opNumMatch = body.match(/Número de operación\s+(\d+)/);
  if (opNumMatch) {
    movement.operationNumber = opNumMatch[1];
  }
  
  return movement;
}

/**
 * Create base movement object
 */
function createBaseMovement() {
  return {
    id: Utilities.getUuid(),
    type: MovementType.EXPENSE,
    accountOrCardId: '',
    date: new Date().toISOString(),
    payee: '',
    bankDescription: '',
    additionalInfo: '',
    notes: '',
    currency: 'PEN',
    amount: 0,
    operationNumber: null,
    categoryId: null,
    subcategoryId: null,
    isStub: false,
    labels: ['BCP', 'AUTO_IMPORTED'],
    linkedMovementId: null,
    targetAccountOrCardId: null
  };
}

/**
 * Parse Spanish date format to ISO string
 */
function parseSpanishDate(dateStr) {
  const months = {
    'enero': 0, 'febrero': 1, 'marzo': 2, 'abril': 3,
    'mayo': 4, 'junio': 5, 'julio': 6, 'agosto': 7,
    'septiembre': 8, 'octubre': 9, 'noviembre': 10, 'diciembre': 11
  };
  
  const match = dateStr.match(/(\d{2}) de (\w+) de (\d{4}) - (\d{2}):(\d{2}) (AM|PM)/);
  if (!match) {
    return new Date().toISOString();
  }
  
  const day = parseInt(match[1]);
  const month = months[match[2].toLowerCase()];
  const year = parseInt(match[3]);
  let hour = parseInt(match[4]);
  const minute = parseInt(match[5]);
  const ampm = match[6];
  
  if (ampm === 'PM' && hour !== 12) {
    hour += 12;
  } else if (ampm === 'AM' && hour === 12) {
    hour = 0;
  }
  
  // Peru timezone is UTC-5
  const date = new Date(year, month, day, hour, minute);
  return date.toISOString();
}

/**
 * Send transaction data to Azure Function
 */
function sendToAzureFunction(transaction) {
  try {
    const options = {
      method: 'post',
      contentType: 'application/json',
      payload: JSON.stringify(transaction),
      muteHttpExceptions: true
    };
    
    const response = UrlFetchApp.fetch(CONFIG.AZURE_FUNCTION_URL, options);
    const responseCode = response.getResponseCode();
    
    if (responseCode >= 200 && responseCode < 300) {
      Logger.log(`Successfully sent transaction to Azure Function: ${transaction.operationNumber}`);
      return true;
    } else {
      Logger.log(`Azure Function returned error: ${responseCode} - ${response.getContentText()}`);
      return false;
    }
  } catch (error) {
    Logger.log(`Error sending to Azure Function: ${error.message}`);
    return false;
  }
}

/**
 * Apply a label to a thread
 */
function applyLabel(thread, labelName) {
  try {
    let label = GmailApp.getUserLabelByName(labelName);
    if (!label) {
      label = GmailApp.createLabel(labelName);
    }
    thread.addLabel(label);
  } catch (error) {
    Logger.log(`Error applying label: ${error.message}`);
  }
}

/**
 * Setup time-based trigger (run this once manually)
 */
function setupTrigger() {
  // Delete existing triggers
  const triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(trigger => {
    if (trigger.getHandlerFunction() === 'checkEmailTrigger') {
      ScriptApp.deleteTrigger(trigger);
    }
  });
  
  // Create new trigger to run every 5 minutes
  ScriptApp.newTrigger('checkEmailTrigger')
    .timeBased()
    .everyMinutes(5)
    .create();
  
  Logger.log('Trigger created successfully');
}

/**
 * Manual test function
 */
function testParser() {
  const testBody = `Hola Genaro Rafael,

Realizaste un consumo de S/ 60.00 con tu Tarjeta de Crédito BCP en QEMA MANCORA BAR.

Por tu seguridad, te enviamos los datos de tu operación.

Monto

Total del consumo                                    S/ 60.00


Datos de la operación

Operación realizada                          Consumo Tarjeta de Crédito

Fecha y hora                                 29 de diciembre de 2025 - 07:25 PM

Número de Tarjeta de Crédito                 ***********7385

Empresa                                      QEMA MANCORA BAR

Número de operación                          0000481573`;
  
  const result = parseTransaction('Test', testBody, testBody, new Date());
  Logger.log(JSON.stringify(result, null, 2));
}
